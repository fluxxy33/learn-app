<Window x:Class="StudyDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudyDesk" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================================================== Barre latérale -->
        <DockPanel Grid.Column="0" Background="{DynamicResource Sidebar}" Margin="10,12,10,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,0,18">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28" />
                <TextBlock Text="StudyDesk" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Bas : Pomodoro, profil, réglages -->
            <StackPanel DockPanel.Dock="Bottom">
                <Border x:Name="PomodoroCard" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="PomodoroPhaseText" Text="Pomodoro" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock x:Name="PomodoroCount" Text="" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PomodoroPlay" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Démarrer / pause" Click="PomodoroPlay_Click" />
                                <Button x:Name="PomodoroStop" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Arrêter" Click="PomodoroStop_Click" />
                            </StackPanel>
                            <TextBlock x:Name="PomodoroTime" Text="25:00" FontSize="24" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar x:Name="PomodoroProgress" Style="{StaticResource ProgressBarThin}" Height="4" Margin="0,6,0,0" Value="0" />
                    </StackPanel>
                </Border>
                <Button x:Name="ProfileButton" Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left" Padding="8,6" Click="ProfileButton_Click" ToolTip="Changer de profil">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Avatar" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Accent}">
                            <TextBlock x:Name="AvatarLetter" Text="?" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="ProfileName" Text="" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="settings" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                        <TextBlock Text="Réglages" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel>
                <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="home" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" />
                        <TextBlock Text="Accueil" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" Tag="library" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" />
                        <TextBlock Text="Bibliothèque" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavReview" Style="{StaticResource NavItem}" Tag="review" Checked="Nav_Checked">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" />
                        <Border x:Name="DueBadge" DockPanel.Dock="Right" Background="{DynamicResource Accent}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="DueBadgeText" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentFg}" />
                        </Border>
                        <TextBlock Text="Réviser" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                </RadioButton>
                <RadioButton x:Name="NavQuiz" Style="{StaticResource NavItem}" Tag="quiz" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" />
                        <TextBlock Text="Quiz" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavStats" Style="{StaticResource NavItem}" Tag="stats" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" />
                        <TextBlock Text="Statistiques" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavTutorials" Style="{StaticResource NavItem}" Tag="tutorials" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BE;" />
                        <TextBlock Text="Tutoriels" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavPhone" Style="{StaticResource NavItem}" Tag="phone" Checked="Nav_Checked">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" />
                        <Ellipse x:Name="PhoneDot" DockPanel.Dock="Right" Width="8" Height="8" Fill="{DynamicResource Good}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock Text="Téléphone" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <!-- ===================================================== Contenu -->
        <Border Grid.Column="1" Background="{DynamicResource Content}" CornerRadius="10,0,0,0"
                BorderBrush="{DynamicResource Line}" BorderThickness="1,1,0,0">
            <ContentControl x:Name="Host" Focusable="False" />
        </Border>
    </Grid>
</Window>
